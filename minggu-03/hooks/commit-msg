#!/usr/bin/env bash
# commit-msg hook — tolak pesan commit yang tidak mengikuti Conventional Commits
#
# Letakkan di: .git/hooks/commit-msg  (chmod +x)
# Salinan publik di: minggu-03/hooks/commit-msg
#
# Pola yang diterima:  <type>(<scope>): <subject>
#   type    = feat | fix | docs | chore | refactor | test | perf | build | ci
#   scope   = opsional (huruf kecil, angka, dash, underscore)
#   subject = singkat, dimulai huruf kecil, tanpa titik di akhir
#
# Bypass merge/revert/commit amend: jika argumen ke-2 berupa --fixup/--squash atau
# file pesan yang dimulai dengan "Merge " / "Revert ", hook tidak menolak (itu di luar
# kontrol kita).

set -euo pipefail

MSG_FILE="${1:?usage: $0 <commit-msg-file>}"
COMMIT_MSG=$(cat "$MSG_FILE")

red()   { printf '\033[31m%s\033[0m\n' "$*" >&2; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
bold()  { printf '\033[1m%s\033[0m\n' "$*"; }

# Baris pertama yang tidak berupa komentar (#)
FIRST_LINE=$(printf '%s\n' "$COMMIT_MSG" | grep -vE '^#' | head -n 1)

# Bypass untuk pesan yang di-generate git (merge, revert, fixup, squash)
case "$FIRST_LINE" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*)
        green "[commit-msg] Bypass (git-generated message)."
        exit 0
        ;;
esac

# Pola Conventional Commits — anchored, hanya baris pertama
PATTERN='^(feat|fix|docs|chore|refactor|test|perf|build|ci)(\([a-z0-9_-]{0,64}\))?!?: [^[:space:]].+[^[:space:]]$|^[a-z]+(\([^)]+\))?!?: [^[:space:]]+[^[:space:]]$'

bold "[commit-msg] Memeriksa pesan: $FIRST_LINE"

if ! grep -qE "$PATTERN" <<< "$FIRST_LINE"; then
    red "✗ Pesan commit DITOLAK: tidak mengikuti Conventional Commits."
    red "  Baris pertama: $FIRST_LINE"
    red ""
    red "Format yang diminta:"
    red "  <type>(<scope>): <subject>"
    red ""
    red "Type yang diterima:"
    red "  feat, fix, docs, chore, refactor, test, perf, build, ci"
    red ""
    red "Contoh yang valid:"
    red "  feat: tambah konfigurasi SSH"
    red "  fix(auth): perbaiki pesan galat login"
    red "  docs: perbarui README dengan daftar skrip"
    red "  chore: abaikan build/ dan *.log"
    red "  refactor!: pisahkan handler menjadi modul terpisah"
    exit 1
fi

# Subjek tidak boleh diakhiri dengan tanda baca selain huruf/angka
if [[ "$FIRST_LINE" =~ \.\ $ ]] || [[ "$FIRST_LINE" =~ \.$ ]]; then
    red "✗ Subject tidak boleh diakhiri dengan titik ('.')."
    exit 1
fi

green "[commit-msg] ✓ Lolos — format Conventional Commits valid."
exit 0