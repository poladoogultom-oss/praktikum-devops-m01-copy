#!/usr/bin/env bash
# pre-commit hook — "Gerbang Mutu Sebelum Commit" (M03 Challenge)
#
# Letakkan di: .git/hooks/pre-commit  (chmod +x)
# Salinan publik di: minggu-03/hooks/pre-commit
#
# Tolak commit yang staged-nya mengandung:
#   - Pola kredensial: ghp_, AKIA, BEGIN PRIVATE KEY, PASSWORD=, SECRET=, TOKEN=
#   - Skrip .sh yang gagal shellcheck
#
# Sumber pemeriksaan: `git diff --cached` (bukan seluruh isi berkas).
#
# Aturan:
#   - set -euo pipefail  → gagal kecil hentikan hook
#   - Pesan galat ke stderr
#   - exit 0 = lolos, exit 1 = ditolak

set -euo pipefail

red()   { printf '\033[31m%s\033[0m\n' "$*" >&2; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
bold()  { printf '\033[1m%s\033[0m\n' "$*"; }

bold "[pre-commit] Memeriksa staged changes…"

# -----------------------------------------------------------------------------
# 1) Deteksi pola kredensial pada staged diff
# -----------------------------------------------------------------------------
CRED_PATTERN='(ghp_|AKIA[0-9A-Z]{8,}|BEGIN .*PRIVATE KEY|(PASSWORD|SECRET|TOKEN)[[:space:]]*=[[:space:]]*[^[:space:]]+)'

# -I: abaikan binary diff, --unified=0: hanya baris yang berubah (tanpa konteks tambahan)
if MATCH_HITS=$(git diff --cached -I'^\+.*/Binary files' --unified=0 \
                  | grep -nEi "$CRED_PATTERN" || true); then
    if [[ -n "$MATCH_HITS" ]]; then
        red "✗ Commit DITOLAK: terdeteksi pola yang menyerupai kredensial pada staged diff."
        red "  Baris yang mencurigakan:"
        printf '%s\n' "$MATCH_HITS" | sed 's/^/    /' >&2
        red ""
        red "Tindakan:"
        red "  1) ROTASI token/kunci yang bocor (anggap compromised)."
        red "  2) Pindahkan nilai ke .env (pastikan masuk .gitignore)."
        red "  3) Ulangi commit tanpa baris tersebut."
        exit 1
    fi
fi

# -----------------------------------------------------------------------------
# 2) shellcheck pada setiap .sh yang di-stage
# -----------------------------------------------------------------------------
# Cari nama file .sh yang baru/modif di index (A|M), bukan yang dihapus (D)
mapfile -t STAGED_SH < <(
    git diff --cached --name-only --diff-filter=ACMR | grep -E '\.sh$' || true
)

if (( ${#STAGED_SH[@]} > 0 )); then
    # Cari shellcheck di lokasi umum (apt, Homebrew, Python venv Scripts di Windows)
    SHELLCHECK_BIN="$(command -v shellcheck 2>/dev/null || true)"
    if [[ -z "$SHELLCHECK_BIN" ]]; then
        for cand in \
            "/c/Users/ASUS/.workbuddy-ai/binaries/python/envs/default/Scripts/shellcheck.exe" \
            "/c/Users/ASUS/.workbuddy-ai/binaries/python/envs/default/Scripts/shellcheck" \
            "/usr/bin/shellcheck" \
            "/usr/local/bin/shellcheck" \
            "/opt/homebrew/bin/shellcheck" ; do
            if [[ -x "$cand" ]]; then
                SHELLCHECK_BIN="$cand"
                break
            fi
        done
    fi

    if [[ -z "$SHELLCHECK_BIN" ]]; then
        red "✗ shellcheck tidak ditemukan di PATH atau lokasi umum."
        red "  Pasang salah satu:  sudo apt install shellcheck   |   pip install shellcheck-py"
        exit 1
    fi

    FAIL=0
    for f in "${STAGED_SH[@]}"; do
        # shellcheck disable=SC2317
        if ! shellcheck_output=$("$SHELLCHECK_BIN" --severity=warning "$f" 2>&1); then
            FAIL=1
            red "✗ shellcheck gagal pada: $f"
            printf '%s\n' "$shellcheck_output" | sed 's/^/    /' >&2
        fi
    done

    if (( FAIL )); then
        red ""
        red "Tindakan: perbaiki peringatan shellcheck sebelum commit."
        exit 1
    fi
fi

green "[pre-commit] ✓ Lolos — tidak ada pola kredensial, shellcheck bersih."
exit 0